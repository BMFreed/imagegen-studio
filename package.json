{
  "name": "imagegen-studio",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm run prototype:typecheck && pnpm run app:typecheck",
    "app:typecheck": "vue-tsc --project tsconfig.app.json --noEmit",
    "app:build": "vite build --config vite.desktop.config.ts && node scripts/build-electron.mjs",
    "app:dev": "node scripts/dev-desktop.mjs",
    "app:start": "pnpm run app:build && env -u ELECTRON_RUN_AS_NODE electron .",
    "app:smoke": "pnpm run app:build && tsx scripts/smoke-desktop.mjs && tsx scripts/smoke-generation-results.mjs && tsx scripts/smoke-generation-actions.mjs && tsx scripts/smoke-accepted-history.mjs && tsx scripts/smoke-generation-comparison.mjs",
    "app:smoke:generation": "pnpm run app:build && tsx scripts/smoke-generation-actions.mjs",
    "app:smoke:results": "pnpm run app:build && tsx scripts/smoke-generation-results.mjs",
    "app:test": "tsx --test src/main/db/*.test.ts src/main/models/*.test.ts src/main/projects/*.test.ts src/main/runtime/*.test.mjs src/renderer/components/*.test.ts src/shared/projects/*.test.ts",
    "app:db-types": "tsx scripts/generate-db-types.ts",
    "prototype:dev": "vite --config docs/prototype-app/vite.config.ts --host 127.0.0.1",
    "prototype:build": "vite build --config docs/prototype-app/vite.config.ts",
    "prototype:typecheck": "vue-tsc --project docs/prototype-app/tsconfig.json --noEmit",
    "prototype:test": "playwright test --config docs/prototype-app/playwright.config.ts",
    "prototype:screenshots": "playwright test --config docs/prototype-app/playwright.config.ts",
    "app:smoke:accepted": "pnpm run app:build && tsx scripts/smoke-accepted-history.mjs",
    "app:smoke:comparison": "pnpm run app:build && tsx scripts/smoke-generation-comparison.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@vue-dnd-kit/core": "2.4.6",
    "better-sqlite3": "^13.0.3",
    "konva": "10.7.0",
    "kysely": "^0.29.6",
    "naive-ui": "^2.44.1",
    "valibot": "1.5.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@playwright/test": "^1.61.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vicons/tabler": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "electron": "44.4.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.6.0",
    "kysely-codegen": "^0.20.0",
    "prettier": "^3.9.4",
    "prettier-plugin-jsdoc": "^1.8.1",
    "productive-eslint": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vue": "^3.5.38",
    "vue-tsc": "^3.3.6"
  }
}

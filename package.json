{
  "name": "imagegen-studio-docs-tooling",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm run prototype:typecheck",
    "prototype:dev": "vite --config docs/prototype-app/vite.config.ts --host 127.0.0.1",
    "prototype:build": "vite build --config docs/prototype-app/vite.config.ts",
    "prototype:typecheck": "vue-tsc --project docs/prototype-app/tsconfig.json --noEmit",
    "prototype:test": "playwright test --config docs/prototype-app/playwright.config.ts",
    "prototype:screenshots": "playwright test --config docs/prototype-app/playwright.config.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@vue-dnd-kit/core": "2.4.6",
    "naive-ui": "^2.44.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.1.0",
    "@vicons/tabler": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "prettier-plugin-jsdoc": "^1.8.1",
    "productive-eslint": "^4.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vue": "^3.5.38",
    "vue-tsc": "^3.3.6"
  }
}

{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@docs-assets/*": ["../assets/*"]
    }
  },
  "include": ["*.ts", "src/**/*.ts", "src/**/*.vue", "tests/**/*.ts"]
}
